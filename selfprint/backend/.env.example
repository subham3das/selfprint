# ==========================================
# SelfPrint Enterprise Backend Configuration
# ==========================================

# Server Configuration (Render assigns PORT automatically)
PORT=5000
NODE_ENV=production

# Database (MongoDB Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/selfprint?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated URLs, or * for all)
CORS_ORIGIN=https://selfprint.vercel.app,http://localhost:5173

# Frontend URL (For email links & client redirects)
FRONTEND_URL=https://selfprint.vercel.app

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Authentication & JWT Security
JWT_SECRET=generate_a_random_64_character_hex_string_for_production
JWT_EXPIRES_IN=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Super Admin Initial Identity
SUPER_ADMIN_EMAIL=admin@selfprint.com
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_DISPLAY_NAME=Super Admin
SUPER_ADMIN_PASSWORD=StrongSecurePassword123!

# Transactional SMTP Email (Optional - will boot safely even if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=SelfPrint
EMAIL_FROM_ADDRESS=noreply@selfprint.com

# Razorpay Gateway (Optional)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# GitHub Releases (Desktop Connector Installer)
GITHUB_OWNER=subham3das
GITHUB_REPO=selfprint
