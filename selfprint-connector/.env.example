# Self Print Connector Configuration

# Port for local diagnostic / health HTTP server if enabled
PORT=4500

# Backend Cloud API and WebSocket Gateway
BACKEND_URL=http://localhost:3000

# Connector Device Identifier (Leave blank for first-time pairing)
DEVICE_ID=

# Cryptographic Device Token for Authentication
DEVICE_TOKEN=

# Associated Store Tenant ID
STORE_ID=

# Log Level: debug | info | warn | error
LOG_LEVEL=info

# Heartbeat Interval in Milliseconds (Default: 15000 = 15s)
HEARTBEAT_INTERVAL_MS=15000
